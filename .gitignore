# ==========================================
# Gmail OAuth
# ==========================================

# Real Google OAuth credentials
backend/auth/credentials.json

# OAuth access/refresh tokens
backend/tokens/token.json

# Optional token backups
backend/tokens/*.bak

# Keep example token file
!backend/tokens/token.example.json
# ==========================================
# Logs
# ==========================================

*.log
logs/
*.pid

# ==========================================
# Testing / Coverage
# ==========================================

.coverage
.pytest_cache/
htmlcov/

# ==========================================
# Type Checkers / Linters
# ==========================================

.mypy_cache/
.ruff_cache/

# ==========================================
# Jupyter
# ==========================================

.ipynb_checkpoints/

# ==========================================
# Temporary Files
# ==========================================

*.tmp
*.temp
*.cache

# ==========================================
# Local Configuration
# ==========================================

backend/.env
backend/.env.local

# ==========================================
# Keep Example Files
# ==========================================

!backend/.env.example
!backend/auth/credentials.example.json
!backend/auth/README.md
!backend/tokens/README.md
!backend/tokens/.gitkeep
# Sensitive Project Docs
*.pdf
*.docx

# Databases
*.db
*.sqlite3

# Python Caches
__pycache__/
*.pyc
